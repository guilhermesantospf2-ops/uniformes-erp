{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/vendas", "destination": "/vendas.html" },
    { "source": "/lp", "destination": "/vendas.html" },
    { "source": "/demo", "destination": "/demo.html" },
    { "source": "/ativar", "destination": "/ativar.html" },
    { "source": "/gerar-acesso", "destination": "/gerar-acesso.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
